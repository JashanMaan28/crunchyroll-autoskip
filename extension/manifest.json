{
  "manifest_version": 3,
  "name": "Crunchyroll Autoskip",
  "short_name": "CR Autoskip",
  "version": "1.1.1",
  "description": "Netflix-style auto-skip for Crunchyroll: intros, recaps, credits and previews, with a countdown and smart next episode.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://static.crunchyroll.com/skip-events/*",
    "https://www.crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/planner.js",
        "content/page.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/figtree-latin.woff2"
      ],
      "matches": [
        "https://www.crunchyroll.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Crunchyroll Autoskip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-autoskip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn auto-skip on or off"
    },
    "mark-segment": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mark the start, then the end, of a part to skip"
    }
  }
}
